@model MachineShopManager.ViewModels.ProjectCreateViewModel
@using MachineShopManager.Enums
@{ ViewData["Title"] = "Novo Projeto"; }
<div class="container mt-4"><h2>Novo Projeto</h2><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="card mb-3"><div class="card-header">Informações do aluno</div><div class="card-body"><div class="mb-3"><label asp-for="Project.StudentName"></label><input asp-for="Project.StudentName" class="form-control"/></div><div class="mb-3"><label asp-for="Project.StudentEmail"></label><input asp-for="Project.StudentEmail" class="form-control"/></div><div class="mb-3"><label asp-for="Project.Phone"></label><input asp-for="Project.Phone" class="form-control"/></div></div></div>
<div class="card mb-3"><div class="card-header">Informações do projeto</div><div class="card-body"><div class="mb-3"><label asp-for="Project.ProjectName"></label><input asp-for="Project.ProjectName" class="form-control"/></div><div class="mb-3"><label asp-for="Project.ServiceType"></label><select asp-for="Project.ServiceType" asp-items="Html.GetEnumSelectList<ServiceType>()" class="form-select" id="service-type"></select></div><div class="mb-3"><label asp-for="Project.DesiredDelivery"></label><input asp-for="Project.DesiredDelivery" type="date" class="form-control"/></div><div class="mb-3"><label asp-for="Project.Notes"></label><textarea asp-for="Project.Notes" class="form-control"></textarea></div></div></div>
<div class="card mb-3"><div class="card-header">Requisitos do serviço <small class="text-muted">* Campo obrigatório</small></div><div class="card-body"><div class="alert alert-info py-2">Você pode enviar quantos arquivos quiser em cada campo, desde que o <strong>total do projeto não passe de 100 MB</strong>.</div><div id="upload-total" class="text-danger mb-2" hidden></div>
<section data-service="Impressao3D"><h4>Requisitos para impressão 3D</h4><div class="mb-3"><label>Arquivo(s) 3D *</label><small class="d-block text-muted">Envie o(s) arquivo(s) 3D da peça (STL, STEP, OBJ, G-code ou ZIP). Pode selecionar vários.</small><input asp-for="Requirements.ThreeDFile" type="file" multiple accept=".stl,.step,.obj,.gcode,.zip" class="form-control" data-required/><span asp-validation-for="Requirements.ThreeDFile" class="text-danger"></span></div><div class="mb-3"><label>Material *</label><select asp-for="Requirements.PrintMaterial" class="form-select" data-required><option value="">Selecione</option><option>ABS</option><option>PLA</option><option>Outro</option></select></div><div class="mb-3"><label>Cor do filamento *</label><input asp-for="Requirements.FilamentColor" class="form-control" data-required/></div><hr/><p>Opcionais</p><div class="mb-3"><label>Percentual e padrão de preenchimento</label><input asp-for="Requirements.Infill" placeholder="20% Gyroid" class="form-control"/></div><div class="mb-3"><label>Orientação preferencial da peça</label><input asp-for="Requirements.PreferredOrientation" class="form-control"/></div><div class="mb-3"><label>Acabamento pós-impressão</label><input asp-for="Requirements.PostProcessing" class="form-control"/></div></section>
<section data-service="UsinagemCNC"><h4>Requisitos para usinagem CNC</h4><div class="mb-3"><label>Modelo(s) 3D *</label><small class="d-block text-muted">Para preparação e geração do código G (STEP, IGES, G-code ou ZIP). Pode selecionar vários.</small><input asp-for="Requirements.CncModelFile" type="file" multiple accept=".step,.iges,.igs,.gcode,.zip" class="form-control" data-required/></div><div class="mb-3"><label>Material *</label><input asp-for="Requirements.MaterialSpecification" placeholder="APENAS MDF permitido!" class="form-control" data-required/></div><div class="mb-3"><label>Quantidade de peças *</label><input asp-for="Requirements.Quantity" type="number" min="1" step="1" class="form-control" data-required/></div><div class="mb-3"><label>Desenho técnico 2D *</label><small class="d-block text-muted">PDF com cotas críticas e tolerâncias dimensionais.</small><input asp-for="Requirements.TechnicalDrawing" type="file" multiple accept=".pdf" class="form-control" data-required/></div></section>
<section data-service="Furacao"><h4>Requisitos para furação</h4><div class="mb-3"><label>Posição das furações *</label><input asp-for="Requirements.HolePositionFile" type="file" multiple accept=".pdf,.stl,.step,.obj,.gcode,.zip" class="form-control" data-required/></div><div class="mb-3"><label>Diâmetro do furo *</label><input asp-for="Requirements.HoleDiameter" placeholder="6 mm" class="form-control" data-required/></div><div class="mb-3"><label>Profundidade *</label><input asp-for="Requirements.HoleDepth" placeholder="Passante, cego ou profundidade definida" class="form-control" data-required/></div><div class="mb-3"><label>Rosca/rebaixo</label><input asp-for="Requirements.ThreadOrRecess" class="form-control"/></div><div class="mb-3"><label>Tolerância do furo</label><input asp-for="Requirements.HoleTolerance" class="form-control"/></div></section>
<section data-service="Solda"><h4>Requisitos para soldagem</h4><div class="mb-3"><label>Desenho/croqui da montagem *</label><input asp-for="Requirements.WeldingDrawing" type="file" multiple accept=".pdf,.jpg,.jpeg,.png" class="form-control" data-required/></div><div class="mb-3"><label>Materiais de base *</label><input asp-for="Requirements.BaseMaterials" class="form-control" data-required/></div><div class="mb-3"><label>Processo de soldagem *</label><select asp-for="Requirements.WeldingProcess" class="form-select" data-required><option value="">Selecione</option><option>TIG</option><option>MIG/MAG</option><option>Eletrodo Revestido</option><option>Outro</option></select></div></section>
<section data-service="Dobra"><h4>Requisitos para dobra</h4><div class="mb-3"><label>Desenho 2D/planificação *</label><input asp-for="Requirements.BendingDrawing" type="file" multiple accept=".pdf,.step,.gcode,.zip" class="form-control" data-required/></div><div class="mb-3"><label>Material *</label><input asp-for="Requirements.SheetMaterial" class="form-control" data-required/></div><div class="mb-3"><label>Espessura *</label><input asp-for="Requirements.SheetThickness" class="form-control" data-required/></div><div class="mb-3"><label>Ângulo(s) de dobra *</label><input asp-for="Requirements.BendAngles" class="form-control" data-required/></div><div class="mb-3"><label>Raio interno *</label><input asp-for="Requirements.InnerRadius" class="form-control" data-required/></div></section>
<section data-service="Outro"><h4>Serviço personalizado</h4><div class="mb-3"><label>Descrição detalhada *</label><textarea asp-for="Requirements.CustomDescription" class="form-control" rows="5" data-required></textarea></div><div class="mb-3"><label>Croqui, foto ou arquivo base *</label><input asp-for="Requirements.ReferenceFile" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.stl,.step,.obj,.gcode,.zip" class="form-control" data-required/></div><div class="mb-3"><label>Dimensões brutas máximas *</label><input asp-for="Requirements.MaximumDimensions" placeholder="300 × 200 × 100 mm" class="form-control" data-required/></div></section>
</div></div><button class="btn btn-success">Cadastrar projeto</button></form></div>
@section Scripts { <script>document.addEventListener('DOMContentLoaded',()=>{const s=document.querySelector('#service-type'),q=document.querySelectorAll('[data-service]');function r(){const selected=s.options[s.selectedIndex].text;q.forEach(x=>{let a=x.dataset.service===selected;x.hidden=!a;x.querySelectorAll('input,select,textarea').forEach(i=>{i.disabled=!a;i.required=a&&i.hasAttribute('data-required')})})}s.addEventListener('change',r);r();
const MAX=100*1024*1024,form=document.querySelector('form[enctype]'),msg=document.querySelector('#upload-total');
function total(){let t=0;form.querySelectorAll('input[type=file]:not(:disabled)').forEach(i=>{for(const f of i.files)t+=f.size});return t}
function check(){const t=total();if(t>MAX){msg.textContent='Os arquivos somam '+(t/1048576).toFixed(1)+' MB. O limite é 100 MB no total.';msg.hidden=false;return false}msg.hidden=true;return true}
form.addEventListener('change',e=>{if(e.target.type==='file')check()});
form.addEventListener('submit',e=>{if(!check()){e.preventDefault();msg.scrollIntoView({behavior:'smooth',block:'center'})}})})</script> }
