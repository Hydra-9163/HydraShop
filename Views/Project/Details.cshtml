@model MachineShopManager.Models.Project
@using MachineShopManager.Enums

@{
    ViewData["Title"] = "Detalhes";

    string GetStatusText(ProjectStatus status)
    {
        return status switch
        {
            ProjectStatus.EmFila => "Em fila",
            ProjectStatus.EmProducao => "Em produção",
            ProjectStatus.Pausado => "Pausado",
            ProjectStatus.ProntoParaEntrega => "Pronto para entrega",
            ProjectStatus.Entregue => "Entregue",
            ProjectStatus.Cancelado => "Cancelado",
            _ => "Desconhecido"
        };
    }
}

<h2>@Model.ProjectName</h2>

<hr />

<div class="row">

    <div class="col-md-6">

        <h5>Informações</h5>

        <p>
            <strong>Código:</strong>
            @Model.Code
        </p>

        <p>
            <strong>Aluno:</strong>
            @Model.StudentName
        </p>

        <p>
            <strong>Email:</strong>
            @Model.StudentEmail
        </p>

        <p>
            <strong>Telefone:</strong>
            @Model.Phone
        </p>

    </div>


    <div class="col-md-6">

        <h5>Projeto</h5>

        <p>
            <strong>Serviço:</strong>
            @Model.ServiceType
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>


        <form asp-controller="Project"
              asp-action="UpdateStatus"
              method="post"
              class="mt-3">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <label class="form-label">
                Alterar status
            </label>

            <div class="input-group">

                <select name="status"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<ProjectStatus>()">
                </select>

                <button type="submit"
                        class="btn btn-primary">
                    Atualizar
                </button>

            </div>

        </form>


        <p class="mt-3">
            <strong>Entrega:</strong>
            @Model.DesiredDelivery.ToShortDateString()
        </p>

    </div>

</div>

@if (Model.ServiceRequirement != null)
{
    <partial name="_ServiceRequirements" model="Model.ServiceRequirement" />
}


<hr />

<h5>Observações</h5>

<div class="border rounded p-3">

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        @Model.Notes
    }
    else
    {
        <span class="text-muted">
            Nenhuma observação registrada.
        </span>
    }

</div>


<!-- ===================================== -->
<!-- RELATÓRIO FOTOGRÁFICO -->
<!-- ===================================== -->

<hr />

<h5>Relatório Fotográfico</h5>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<form asp-controller="Project"
      asp-action="UploadPhoto"
      method="post"
      enctype="multipart/form-data"
      class="mb-4">

    <input type="hidden"
           name="projectId"
           value="@Model.Id" />


    <div class="mb-3">

        <label class="form-label">
            Adicionar foto ao relatório
        </label>

        <input type="file"
               name="photo"
               class="form-control"
               accept=".jpg,.jpeg,.png"
               required />

    </div>


    <button type="submit"
            class="btn btn-primary">

        📷 Adicionar Foto

    </button>

</form>


<!-- ===================================== -->
<!-- GALERIA DE FOTOS -->
<!-- ===================================== -->

@if (Model.Photos != null && Model.Photos.Any())
{
    <div class="row g-3">

        @foreach (var photo in Model.Photos)
        {
            <div class="col-md-4">

                <div class="card shadow-sm">

                    <img src="@photo.FilePath"
                         class="card-img-top"
                         alt="@photo.FileName"
                         style="height: 220px; object-fit: cover;" />

                    <div class="card-body">

                        <small class="text-muted">
                            @photo.UploadedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                        </small>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="alert alert-secondary">
        Nenhuma foto foi adicionada ao relatório ainda.
    </div>
}

<div class="card mb-4">

    <div class="card-header">
        <h4 class="mb-0">Histórico do projeto</h4>
    </div>

    <div class="card-body">

        @if (Model.History != null && Model.History.Any())
        {
            <div class="project-history">

                @foreach (var history in Model.History)
                {
                    <div class="history-item">

                        <div class="history-dot"></div>

                        <div class="history-content">

                            <strong>
                                @GetStatusText(history.NewStatus)
                            </strong>

                            <p class="mb-1">
                                @history.Description
                            </p>

                            <small class="text-secondary">
                                @history.ChangedAt
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy 'às' HH:mm")
                                <br />
                                Por: @(history.OperatorEmail ?? "Operador não informado")
                            </small>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <p class="text-secondary mb-0">
                Nenhuma alteração registrada.
            </p>
        }

    </div>

</div>

<!-- ===================================== -->
<!-- BOTÕES -->
<!-- ===================================== -->

<div class="mt-4">
    @if (Model.Archived)
    {
        <form asp-action="Restore" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Desarquivar projeto</button>
        </form>
    }
    else
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar Projeto</a>
        <form asp-action="Archive" method="post" class="d-inline" onsubmit="return confirm('Arquivar este projeto?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger">Arquivar projeto</button>
        </form>
    }

    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Excluir este projeto permanentemente? Essa ação não pode ser desfeita e vai apagar todos os arquivos, fotos e histórico do projeto.');">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Excluir projeto</button>
    </form>



    <a asp-action="Index"
       class="btn btn-secondary">

        Voltar

    </a>

</div>
