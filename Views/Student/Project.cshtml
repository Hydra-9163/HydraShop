@model MachineShopManager.ViewModels.StudentProjectViewModel
@using MachineShopManager.Enums

@{
    ViewData["Title"] = "Meu Projeto";
    var project = Model.Project;

    string GetStatusClass(ProjectStatus status) => status switch
    {
        ProjectStatus.EmFila => "status-fila",
        ProjectStatus.EmProducao => "status-producao",
        ProjectStatus.Pausado => "status-pausado",
        ProjectStatus.ProntoParaEntrega => "status-pronto",
        ProjectStatus.Entregue => "status-entregue",
        ProjectStatus.Cancelado => "status-cancelado",
        _ => ""
    };

    string GetStatusText(ProjectStatus status) => status switch
    {
        ProjectStatus.EmFila => "Em fila",
        ProjectStatus.EmProducao => "Em produção",
        ProjectStatus.Pausado => "Pausado",
        ProjectStatus.ProntoParaEntrega => "Pronto para entrega",
        ProjectStatus.Entregue => "Entregue",
        ProjectStatus.Cancelado => "Cancelado",
        _ => "Desconhecido"
    };

    bool IsCompleted(ProjectStatus step)
    {
        if (project.Status == ProjectStatus.Cancelado) return false;
        if (project.Status == ProjectStatus.Pausado)
            return step is ProjectStatus.EmFila or ProjectStatus.EmProducao;
        return (int)project.Status >= (int)step;
    }
}

<div class="student-project-page">
    <div class="project-header">
        <div><span class="project-label">Projeto</span><h1>@project.ProjectName</h1><p>Código: <strong>@project.Code</strong></p></div>
        <a asp-controller="Home" asp-action="Index" class="back-button">← Consultar outro projeto</a>
    </div>

    <div class="current-status-card">
        <span class="status-label">Status atual</span>
        <div class="current-status @GetStatusClass(project.Status)">@GetStatusText(project.Status)</div>
    </div>

    @if (Model.QueuePosition.HasValue && Model.QueueTotal.HasValue)
    {
        <div class="info-card">
            <h2>Posição na fila</h2>
            <div class="info-grid">
                <div class="info-item"><span>Seu projeto está em</span><strong>@(Model.QueuePosition)º de @Model.QueueTotal projetos</strong></div>
                <div class="info-item"><span>Na sua frente</span><strong>@(Model.QueuePosition.Value - 1) projetos</strong></div>
            </div>
        </div>
    }

    <div class="project-content">
        <div class="info-card">
            <h2>Informações do projeto</h2>
            <div class="info-grid">
                <div class="info-item"><span>Aluno</span><strong>@project.StudentName</strong></div>
                <div class="info-item"><span>Tipo de serviço</span><strong>@project.ServiceType</strong></div>
                <div class="info-item"><span>Data de solicitação</span><strong>@project.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
                <div class="info-item"><span>Entrega desejada</span><strong>@project.DesiredDelivery.ToString("dd/MM/yyyy")</strong></div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(project.Notes))
        { <div class="info-card"><h2>Observações</h2><p class="notes">@project.Notes</p></div> }
        @if (project.ServiceRequirement != null)
        { <partial name="_ServiceRequirements" model="project.ServiceRequirement" /> }

        <div class="info-card">
            <h2>Acompanhamento</h2>
            <div class="status-timeline">
                @foreach (var step in new[] { ProjectStatus.EmFila, ProjectStatus.EmProducao, ProjectStatus.ProntoParaEntrega, ProjectStatus.Entregue })
                {
                    <div class="timeline-item @(IsCompleted(step) ? "completed" : "") @(project.Status == step ? "current" : "")">
                        <div class="timeline-dot"></div><div><strong>@GetStatusText(step)</strong></div>
                    </div>
                }
            </div>
        </div>
        @if (project.Status == ProjectStatus.Pausado)
        { <div class="paused-card"><div class="paused-icon">⏸</div><div><strong>Projeto pausado</strong><p>A produção deste projeto está temporariamente pausada.</p></div></div> }
        @if (project.Status == ProjectStatus.Cancelado)
        { <div class="cancelled-card"><h2>Projeto cancelado</h2><p>Este projeto foi cancelado pela oficina.</p></div> }
    </div>
</div>
