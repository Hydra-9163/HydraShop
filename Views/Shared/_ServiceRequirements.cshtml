@model MachineShopManager.Models.ProjectServiceRequirement
@using MachineShopManager.Enums
<div class="card mb-4"><div class="card-header"><h4 class="mb-0">Requisitos do serviço</h4></div><div class="card-body">
@if (Model.ServiceType == ServiceType.Impressao3D) { <p><strong>Arquivo 3D:</strong> <a href="@Model.ThreeDFilePath">@Model.ThreeDFileName</a></p><p><strong>Material:</strong> @Model.PrintMaterial</p><p><strong>Cor do filamento:</strong> @Model.FilamentColor</p><p><strong>Infill:</strong> @Model.Infill</p><p><strong>Orientação:</strong> @Model.PreferredOrientation</p><p><strong>Acabamento:</strong> @Model.PostProcessing</p> }
@if (Model.ServiceType == ServiceType.UsinagemCNC) { <p><strong>Modelo 3D:</strong> <a href="@Model.CncModelFilePath">@Model.CncModelFileName</a></p><p><strong>Material:</strong> @Model.MaterialSpecification</p><p><strong>Quantidade:</strong> @Model.Quantity</p><p><strong>Desenho técnico 2D:</strong> <a href="@Model.TechnicalDrawingFilePath">@Model.TechnicalDrawingFileName</a></p> }
@if (Model.ServiceType == ServiceType.Furacao) { <p><strong>Diâmetro:</strong> @Model.HoleDiameter</p><p><strong>Profundidade:</strong> @Model.HoleDepth</p><p><strong>Rosca/rebaixo:</strong> @Model.ThreadOrRecess</p><p><strong>Tolerância:</strong> @Model.HoleTolerance</p> }
@if (Model.ServiceType == ServiceType.Solda) { <p><strong>Materiais de base:</strong> @Model.BaseMaterials</p><p><strong>Processo:</strong> @Model.WeldingProcess</p> }
@if (Model.ServiceType == ServiceType.Dobra) { <p><strong>Material:</strong> @Model.SheetMaterial</p><p><strong>Espessura:</strong> @Model.SheetThickness</p><p><strong>Ângulos:</strong> @Model.BendAngles</p><p><strong>Raio interno:</strong> @Model.InnerRadius</p> }
@if (Model.ServiceType == ServiceType.Outro) { <p><strong>Descrição:</strong> @Model.CustomDescription</p><p><strong>Dimensões máximas:</strong> @Model.MaximumDimensions</p> }
</div></div>
