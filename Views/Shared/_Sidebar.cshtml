@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Operator"))
{
<div class="sidebar">

    <div class="logo">
        <img src="~/images/hydra-logo.png" alt="HYDRA FRC" class="sidebar-hydra-logo" />

    </div>

    <hr />

    <a asp-controller="Operator"
       asp-action="Dashboard">

        Dashboard

    </a>

    <a asp-controller="Project"
       asp-action="Create">

        Novo Projeto

    </a>

    <a asp-controller="Project"
       asp-action="Archived">

        Arquivados

    </a>

    <a asp-controller="Project"
       asp-action="Index">

        Projetos

    </a>

    <a asp-controller="Operator"
       asp-action="Statistics">

        Estatísticas

    </a>

    <a asp-controller="Operator"
       asp-action="Settings">

        Configurações

    </a>

    <form asp-controller="Operator" asp-action="Logout" method="post" class="sidebar-logout">
        <button type="submit">Sair</button>
    </form>

</div>
}
