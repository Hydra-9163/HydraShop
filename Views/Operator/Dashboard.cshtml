@model MachineShopManager.ViewModels.OperatorDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@Html.AntiForgeryToken()

    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h1>Hydra Shop</h1>

                <p class="text-secondary mb-0">
                    Gerenciamento de projetos
                </p>
            </div>

            <div class="d-flex gap-2">

                <a asp-controller="Project"
                asp-action="Create"
                class="btn btn-primary">
                    + Novo Projeto
                </a>

            </div>

    </div>

    <div class="kanban-board">

        <!-- EM FILA -->

        <div class="kanban-column"
            data-status="EmFila">

            <div class="kanban-header">

                <span>Em fila</span>

                <span class="badge bg-info column-count">
                    @Model.EmFila.Count
                </span>

            </div>

            @foreach (var project in Model.EmFila)
            {
                <partial name="_ProjectCard" model="project" />
            }

        </div>

        <!-- PRODUÇÃO -->

        <div class="kanban-column"
            data-status="EmProducao">

            <div class="kanban-header">

                <span>Em produção</span>

                <span class="badge bg-primary column-count">
                    @Model.EmProducao.Count
                </span>

            </div>

            @foreach (var project in Model.EmProducao)
            {
                <partial name="_ProjectCard" model="project" />
            }

        </div>


        <!-- PAUSADOS -->

        <div class="kanban-column"
            data-status="Pausado">

            <div class="kanban-header">

                <span>Pausados</span>

                <span class="badge bg-danger column-count">
                    @Model.Pausados.Count
                </span>

            </div>

            @foreach (var project in Model.Pausados)
            {
                <partial name="_ProjectCard" model="project" />
            }

        </div>


        <!-- PRONTOS -->

        <div class="kanban-column"
            data-status="ProntoParaEntrega">

            <div class="kanban-header">

                <span>Pronto para entrega</span>

                <span class="badge bg-success column-count">
                    @Model.Prontos.Count
                </span>

            </div>

            @foreach (var project in Model.Prontos)
            {
                <partial name="_ProjectCard" model="project" />
            }

        </div>


        <!-- ENTREGUES -->

        <div class="kanban-column"
            data-status="Entregue">

            <div class="kanban-header">

                <span>Entregues</span>

                <span class="badge bg-success column-count">
                    @Model.Entregues.Count
                </span>

            </div>

            @foreach (var project in Model.Entregues)
            {
                <partial name="_ProjectCard" model="project" />
            }

        </div>


        <!-- CANCELADOS -->

        <div class="kanban-column"
            data-status="Cancelado">

            <div class="kanban-header">

                <span>Cancelados</span>

                <span class="badge bg-danger column-count">
                    @Model.Cancelados.Count
                </span>

            </div>

            @foreach (var project in Model.Cancelados)
            {
                <partial name="_ProjectCard" model="project" />
            }

        </div>


    </div>

</div>
