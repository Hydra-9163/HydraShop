@model MachineShopManager.Models.Project
@using MachineShopManager.Enums

@{
    ViewData["Title"] = "Detalhes";
}

<h2>@Model.ProjectName</h2>

<hr/>

<div class="row">

    <div class="col-md-6">

        <h5>Informações</h5>

        <p><strong>Código:</strong> @Model.Code</p>

        <p><strong>Aluno:</strong> @Model.StudentName</p>

        <p><strong>Email:</strong> @Model.StudentEmail</p>

        <p><strong>Telefone:</strong> @Model.Phone</p>

    </div>

    <div class="col-md-6">

        <h5>Projeto</h5>

        <p><strong>Serviço:</strong> @Model.ServiceType</p>

        <p><strong>Status:</strong> @Model.Status</p>

            <form asp-controller="Project"
                    asp-action="UpdateStatus"
                    method="post"
                    class="mt-3">

                <input type="hidden"
                    name="id"
                    value="@Model.Id" />

                <label class="form-label">
                    Alterar status
                </label>

        <div class="input-group">

            <select name="status"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<ProjectStatus>()">
            </select>

            <button type="submit"
                    class="btn btn-primary">
                Atualizar
            </button>

        </div>

    </form>

        <p><strong>Entrega:</strong> @Model.DesiredDelivery.ToShortDateString()</p>

    </div>

</div>

<hr/>

<h5>Observações</h5>

<div class="border rounded p-3">

    @Model.Notes

</div>

<hr />

<h5>Relatório Fotográfico</h5>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-controller="Project"
      asp-action="UploadPhoto"
      method="post"
      enctype="multipart/form-data"
      class="mb-4">

    <input type="hidden"
           name="projectId"
           value="@Model.Id" />

    <div class="mb-3">

        <label class="form-label">
            Adicionar foto ao relatório
        </label>

        <input type="file"
               name="photo"
               class="form-control"
               accept=".jpg,.jpeg,.png"
               required />

    </div>

    <button type="submit"
            class="btn btn-primary">

        📷 Adicionar Foto

    </button>

</form>


@if (Model.Photos != null && Model.Photos.Any())
{
    <div class="row g-3">

        @foreach (var photo in Model.Photos)
        {
            <div class="col-md-4">

                <div class="card shadow-sm">

                    <img src="@photo.FilePath"
                         class="card-img-top"
                         alt="@photo.FileName"
                         style="height: 220px; object-fit: cover;" />

                    <div class="card-body">

                        <small class="text-muted d-block mb-2">
                            @photo.UploadedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                        </small>

                        <form asp-controller="Project"
                              asp-action="DeletePhoto"
                              method="post">
                              onsubmit="return confirm('Tem certeza que deseja remover esta foto?');">

                            <input type="hidden"
                                   name="id"
                                   value="@photo.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-danger">

                                🗑 Remover Foto

                            </button>
                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="alert alert-secondary">
        Nenhuma foto foi adicionada ao relatório ainda.
    </div>
}