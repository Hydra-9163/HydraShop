@model MachineShopManager.Models.Project
@using MachineShopManager.Enums

@{
    ViewData["Title"] = "Detalhes";
}

<h2>@Model.ProjectName</h2>

<hr/>

<div class="row">

    <div class="col-md-6">

        <h5>Informações</h5>

        <p><strong>Código:</strong> @Model.Code</p>

        <p><strong>Aluno:</strong> @Model.StudentName</p>

        <p><strong>Email:</strong> @Model.StudentEmail</p>

        <p><strong>Telefone:</strong> @Model.Phone</p>

    </div>

    <div class="col-md-6">

        <h5>Projeto</h5>

        <p><strong>Serviço:</strong> @Model.ServiceType</p>

        <p><strong>Status:</strong> @Model.Status</p>

            <form asp-controller="Project"
                    asp-action="UpdateStatus"
                    method="post"
                    class="mt-3">

                <input type="hidden"
                    name="id"
                    value="@Model.Id" />

                <label class="form-label">
                    Alterar status
                </label>

        <div class="input-group">

            <select name="status"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<ProjectStatus>()">
            </select>

            <button type="submit"
                    class="btn btn-primary">
                Atualizar
            </button>

        </div>

    </form>

        <p><strong>Entrega:</strong> @Model.DesiredDelivery.ToShortDateString()</p>

    </div>

</div>

<hr/>

<h5>Observações</h5>

<div class="border rounded p-3">

    @Model.Notes

</div>